        "narrator": null,
        "narratorEnglish": null,
        "narratorHindi": null,
        "narratorUrdu": null,
        "textArabic": "",
        "translationEnglish": "",
        "translationHindi": "ईमान की मिठास चख ली उस शख्स ने जो अल्लाह के रब होने पर, इस्लाम के दीन होने पर और मुहम्मद (सल्लल्लाहु अलैहि वसल्लम) के रसूल होने पर राज़ी हो गया।",
        "translationUrdu": "ایمان کی مٹھاس چکھ لی اس شخص نے جو اللہ کے رب ہونے پر، اسلام کے دین ہونے پر اور محمد (صلی اللہ علیہ وسلم) کے رسول ہونے پر راضی ہو گیا۔",
        "translationUrduRoman": "Imaan ki mithas chakh li us shakhs ne jo Allah ke Rab hone par, Islam ke deen hone par aur Muhammad (Sallallahu Alaihi Wasallam) ke Rasool hone par raazi ho gaya."
      },
      "source_record_sha256": "c1427ece193cd18c11e88c1ffe04f91f4da1b037ea9416f1365a2e663fed5e65"
    },
