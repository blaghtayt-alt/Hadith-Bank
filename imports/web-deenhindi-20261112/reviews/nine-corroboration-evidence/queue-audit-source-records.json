        "narratorEnglish": null,
        "narratorHindi": null,
        "narratorUrdu": null,
        "textArabic": "",
        "translationEnglish": "",
        "translationHindi": "जिस ने अल्लाह को रब, इस्लाम को दीन और मुहम्मद (सल्लल्लाहु अलैहि वसल्लम) को रसूल तस्लीम कर लिया, उसने ईमान का मज़ा चख लिया।",
        "translationUrdu": "جس نے اللہ کو رب، اسلام کو دین اور محمد (صلی اللہ علیہ وسلم) کو رسول تسلیم کر لیا، اس نے ایمان کا مزہ چکھ لیا۔",
        "translationUrduRoman": "Jis ne Allah ko Rab, Islam ko deen aur Muhammad (Sallallahu Alaihi Wasallam) ko Rasool tasleem kar liya, usne imaan ka maza chakh liya."
      },
      "source_record_sha256": "d266543080b0339b8c102d4a8bf3c5784ed2aa5f18da8b3abe1fbdb2c4ca1684"
    },
