{"schema_version":"hadith-bank-search-record-v1","id":"fawaz:df57907be352:bukhari:5712","language":"bn","source_language_code":"bn","book_key":"bukhari","edition":"fawaz-api-df57907be352","source_id":"fawaz-bukhari-df57907be352-bn","provider_entry_id":5712,"title":"Medicine","text_arabic":null,"text_translation":"বর্ণনাকারী বলেন, ‘আয়িশাহ (রাঃ) আরো বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর অসুখের সময় আমরা তাঁর মুখে ঔষধ ঢেলে দিলাম। তখন তিনি আমাদের ইঙ্গিত দিতে থাকলেন যে, তোমরা আমার মুখে ঔষধ ঢেল না। আমরা মনে করলাম, এটা ঔষধের প্রতি একজন রোগীর স্বভাবজাত অনীহা প্রকাশ মাত্র। এরপর তিনি যখন সুস্থবোধ করলেন তখন বললেনঃ আমি কি তোমাদের আমার মুখে ঔষধ ঢেলে দিতে নিষেধ করিনি? আমরা বললামঃ আমরাতো ঔষধের প্রতি রোগীর স্বভাবজাত অনীহা ভেবেছিলাম। তখন তিনি বললেনঃ আমি এখন যাদেরকে এ ঘরে দেখতে পাচ্ছি তাদের সবার মুখে ওষুধ ঢালা হবে। ‘আব্বাস ছাড়া কেউ বাদ যাবে না। কেননা, তিনি তোমাদের সাথে উপস্থিত ছিলেন না।","number":{"as_supplied_by_language":{"ar":{"arabicnumber":5712,"hadithnumber":5712,"reference":{"book":76,"hadith":29}},"bn":{"arabicnumber":5712,"hadithnumber":5712,"reference":{"book":76,"hadith":29}},"en":{"arabicnumber":5712,"hadithnumber":5712,"reference":{"book":76,"hadith":29}},"ur":{"arabicnumber":5712,"hadithnumber":5712,"reference":{"book":76,"hadith":29}}},"canonical":null,"in_book":null,"numbering_system":"fawaz_api_hadithnumber","source_entry_id":5712},"narrator":{"name":null},"source":{"name":"Fawaz Ahmed Hadith API — Sahih al Bukhari","work_title":"Fawaz Ahmed Hadith API — Sahih al Bukhari","url":"https://github.com/fawazahmed0/hadith-api","record_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/ben-bukhari/5712.json","original_file":"materials/fawaz-bukhari-df57907be352-bn/source-index.json","sha256":"8e3e475ce781d78077122ba9bfa479cf20b88a992c5ac60b08d51070e8ca2357","record_locator":{"path":"materials/fawaz-bukhari-df57907be352-bn/records.jsonl","line":1},"format":"pinned_json_source_index","original_metadata":{"language_a