_as_supplied":"","entry_url_status":"documented_provider_route; exact imported bytes come from the pinned bulk snapshot","field":"text","json_pointer":"/hadiths/2958","name":"Fawaz Ahmed Hadith API — Sunan Abu Dawud — Urdu","project_credits_locator":"imports/web-fawaz-20261112/raw/00d51c7d58ec4d90106fc792ca0f1e400eaaad6a51527a4a69dd1d062a4f8283.txt.gz","project_credits_scope":"provider_project_level_credit_not_record_verified","provider_edition":"urd-abudawud","record_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/urd-abudawud/2959.json","revision":"df57907be35291c91ad6a6691180e22ca9920784","snapshot_compression":"gzip","snapshot_path":"imports/web-fawaz-20261112/raw/44b23f53065a4e4e8128f76aebaf129292410ad323897a8eeb4c5f82fceaa8bd.json.gz","snapshot_sha256":"44b23f53065a4e4e8128f76aebaf129292410ad323897a8eeb4c5f82fceaa8bd","snapshot_stored_sha256":"5071f61722c8645727c023491e8b7c62badc1d5e5c4e1d43b9b248451d352d56","source_text_sha256":"d605d19afcf12410c40aed84b2d5f0b94a23b9e31c15785ccc8c3666a5232f4d","text_spans":{"notes":[],"quotation":[0,635]},"translator":{"evidence":null,"name":null},"url":"https://raw.githubusercontent.com/fawazahmed0/hadith-api/df57907be35291c91ad6a6691180e22ca9920784/editions/urd-abudawud.json"},"text":"وادی القری کے باشندہ سلیم بن مطیر اپنے والد سے روایت کرتے ہیں کہ انہوں نے ان سے بیان کیا کہ میں نے ایک شخص کو کہتے سنا کہ میں نے رسول اللہ صلی اللہ علیہ وسلم سے حجۃ الوداع میں سنا آپ نے ( لوگوں کو اچھی باتوں کا ) حکم دیا ( اور انہیں بری باتوں سے ) منع کیا پھر فرمایا: اے اللہ! کیا میں نے ( تیرا پیغام ) انہیں پہنچا دیا ، لوگوں نے کہا: ہاں، پہنچا دیا، پھر آپ صلی اللہ علیہ وسلم نے فرمایا: جب قریش کے لوگ حکومت اور ملک و اقتدار کے لیے لڑنے لگیں اور عطیہ کی حیثیت رشوت کی بن جائے ( یعنی مستحق کے بجائے غیر مستحق کو ملنے لگے ) تو اسے چھوڑ دو ۔ پوچھا گیا: یہ کون ہیں؟ لوگوں نے کہا: یہ رسول اللہ صلی اللہ علیہ وسلم کے صحابی ذوالزوائد ۱؎ ہیں۔","translation_provenance":{"ai_translation":"unknown","basis":"Pinned publisher catalog attribution; extraction is not translation","origin":"unknown","source_declaration":null,"translator":null,"current_policy":{"classification":"human","basis":"explicit_owner_default_for_new_books_unless_source_declares_otherwise","decision_date_japan":"2026-11-11","policy_path":"catalog/provenance-policy.json"}}}],"source_locator":{"provider_book":"abudawud","revision":"df57907be35291c91ad6a6691180e22ca9920784","typed_hadithnumber":"2959","versions":{"ara":{"json_pointer":"/hadiths/2958","path":"imports/web-fawaz-20261112/raw/216139c5f40a8147e700d62ffa3b5b2fe45d0e034f86941a193c598c10056189.json.gz","sha256":"216139c5f40a8147e700d62ffa3b5b2fe45d0e034f86941a193c598c10056189"},"eng":{"json_pointer":"/hadiths/2958","path":"imports/web-fawaz-20261112/raw/f6bcf73ad96d2f28296232e201e12963e7b3dd5325572fb88365edbbfb0ecd40.json.gz","sha256":"f6bcf73ad96d2f28296232e201e12963e7b3dd5325572fb88365edbbfb0ecd40"},"urd":{"json_pointer":"/hadiths/2958","path":"imports/web-fawaz-20261112/raw/44b23f53065a4e4e8128f76aebaf129292410ad323897a8eeb4c5f82fceaa8bd.json.gz","sha256":"44b23f53065a4e4e8128f76aebaf129292410ad323897a8eeb4c5f82fceaa8bd"}}},"counterparts":{"schema":"hadith-bank-counterpart-link-v1","status":"unresolved","match_method":"no_verified_source_counterpart","match_note":null,"provider_identity":{"provider":"hadeethenc","id":null,"basis":[],"status":"absent","candidates":[]},"quotation_evidence":null,"arabic":{"text":"حَدَّثَنَا هِشَامُ بْنُ عَمَّارٍ، حَدَّثَنَا سُلَيْمُ بْنُ مُطَيْرٍ، - مِنْ أَهْلِ وَادِي الْقُرَى - عَنْ أَبِيهِ، أَنَّهُ حَدَّثَهُ قَالَ سَمِعْتُ رَجُلاً، يَقُولُ سَمِعْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم فِي حَجَّةِ الْوَدَاعِ فَأَمَرَ النَّاسَ وَنَهَاهُمْ ثُمَّ قَالَ ‏\"‏ اللَّهُمَّ هَلْ بَلَّغْتُ ‏\"‏ ‏.‏ قَالُوا اللَّهُمَّ نَعَمْ ‏.‏ ثُمَّ قَالَ ‏\"‏ إِذَا تَجَاحَفَتْ قُرَيْشٌ عَلَى الْمُلْكِ فِيمَا بَيْنَهَا وَعَادَ الْعَطَاءُ أَوْ كَانَ رُشًا فَدَعُوهُ ‏\"‏ ‏.‏ فَقِيلَ مَنْ هَذَا قَالُوا هَذَا ذُو الزَّوَائِدِ صَاحِبُ رَسُولِ اللَّهِ صلى الله عليه وسلم ‏.‏","citation":null,"references":[],"source_name":"Fawaz Ahmed Hadith API — Sunan Abu Dawud","source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/ara-abudawud/2959.json","source_snapshot":"fawaz-api-df57907be352","text_sha256":"aaa235c3ebe9ff9bd6912ba3265881b91eaf12ef3f911f3e756f0accc88f35de","match_status":"source_supplied","scope":"same_provider_entry","translation_origin":"unknown","source_record_id":"fawaz:df57907be352:abudawud:2959"},"english":null}}
