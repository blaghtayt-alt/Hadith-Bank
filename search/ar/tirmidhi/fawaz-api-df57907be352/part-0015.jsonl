ndent_qc_asserted":false,"rights_clearance_asserted":false,"historical_release_status":"owner_authorized_source_import"},"language_versions":[{"comments":[{"embedded_narrations":"retained_here_pending_separate_boundary_review","scope":"source_compiler_note","source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/ara-tirmidhi/1597.json","text":"قَالَ وَفِي الْبَابِ عَنْ عَائِشَةَ وَعَبْدِ اللَّهِ بْنِ عُمَرَ وَأَسْمَاءَ بِنْتِ يَزِيدَ ‏.‏ قَالَ أَبُو عِيسَى هَذَا حَدِيثٌ حَسَنٌ صَحِيحٌ لاَ نَعْرِفُهُ إِلاَّ مِنْ حَدِيثِ مُحَمَّدِ بْنِ الْمُنْكَدِرِ ‏.‏ وَرَوَى سُفْيَانُ الثَّوْرِيُّ وَمَالِكُ بْنُ أَنَسٍ وَغَيْرُ وَاحِدٍ هَذَا الْحَدِيثَ عَنْ مُحَمَّدِ بْنِ الْمُنْكَدِرِ نَحْوَهُ ‏.‏ قَالَ وَسَأَلْتُ مُحَمَّدًا عَنْ هَذَا الْحَدِيثِ فَقَالَ لاَ أَعْرِفُ لأُمَيْمَةَ بِنْتِ رُقَيْقَةَ غَيْرَ هَذَا الْحَدِيثِ ‏.‏ وَأُمَيْمَةُ امْرَأَةٌ أُخْرَى لَهَا حَدِيثٌ عَنْ رَسُولِ اللَّهِ صلى الله عليه وسلم ‏.‏"},{"scope":"provider_assessment_metadata","source_grade":{"grade":"Sahih","name":"Ahmad Muhammad Shakir"},"source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/ara-tirmidhi/1597.json","text":"Source assessment — Ahmad Muhammad Shakir: Sahih"},{"scope":"provider_assessment_metadata","source_grade":{"grade":"Sahih","name":"Al-Albani"},"source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/ara-tirmidhi/1597.json","text":"Source assessment — Al-Albani: Sahih"},{"scope":"provider_assessment_metadata","source_grade":{"grade":"Hasan Sahih","name":"Bashar Awad Maarouf"},"source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/ara-tirmidhi/1597.json","text":"Source assessment — Bashar Awad Maarouf: Hasan Sahih"},{"scope":"provider_assessment_metadata","source_grade":{"grade":"Isnaad Sahih","name":"Zubair Ali Zai"},"source_url":"https://cdn.jsdelivr.