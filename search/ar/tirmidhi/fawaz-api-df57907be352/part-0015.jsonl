তব্য সম্পাদন করবে)। আমি বললাম, আমাদের নিজেদের চাইতে আল্লাহ ও তার রাসূল আমাদের উপর অনেক বেশি অনুগ্রহশীল। আমি আরো বললাম, হে আল্লাহর রাসূল! আমাদেরকে শপথ করান। সুফিয়ান বলেন, তার কথার অর্থ ছিল, আমাদের হাত স্পর্শ করুন (যেভাবে পুরুষদের হাত স্পর্শ করে শপথ করা হয়)। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেনঃ আমার বক্তব্য একজন মহিলার প্রতি যেমন এক শতজন মহিলার উপরেও ঠিক তেমনই। সহীহ, ইবনু মা-জাহ (২৮৭৪) আইশা, আবদুল্লাহ ইবনু আমর ও আসমা বিনতু ইয়াযীদ (রাঃ) হতেও এ অনুচ্ছেদে হাদীস বর্ণিত আছে।","translation_provenance":{"ai_translation":"unknown","basis":"Pinned publisher catalog attribution; extraction is not translation","origin":"unknown","source_declaration":null,"translator":null,"current_policy":{"classification":"human","basis":"explicit_owner_default_for_new_books_unless_source_declares_otherwise","decision_date_japan":"2026-11-11","policy_path":"catalog/provenance-policy.json"}}}],"source_locator":{"provider_book":"tirmidhi","revision":"df57907be35291c91ad6a6691180e22ca9920784","typed_hadithnumber":"1597","versions":{"ara":{"json_pointer":"/hadiths/1605","path":"imports/web-fawaz-20261112/raw/408028cd56329ed78edbe3ad443beb96b58e16c3e5bd49f9bc7b0eac77c8820f.json.gz","sha256":"408028cd56329ed78edbe3ad443beb96b58e16c3e5bd49f9bc7b0eac77c8820f"},"ben":{"json_pointer":"/hadiths/1605","path":"imports/web-fawaz-20261112/raw/17080a67cff1fe216e8ba8eda3a628952f745027d7d682cf3101ddd56459e72c.json.gz","sha256":"17080a67cff1fe216e8ba8eda3a628952f745027d7d682cf3101ddd56459e72c"},"eng":{"json_pointer":"/hadiths/1605","path":"imports/web-fawaz-20261112/raw/f64f1a5e6f2614e164e3b10138412af322d3959011bf84d67f428f79b3858afb.json.gz","sha256":"f64f1a5e6f2614e164e3b10138412af322d3959011bf84d67f428f79b3858afb"},"urd":{"json_pointer":"/hadiths/1605","path":"imports/web-fawaz-20261112/raw/e9e8b32660a8a9c4e25c6c344149e8c9429e1aa90e2d5414029b9727ffb53006.json.gz","sha256":"e9e8b32660a8a9c4e25c6c344149e8c9429e1aa90e2d5414029b9727ffb53006"}}},"counterparts":{"schema":"hadith-bank-counterpart-link-v1","status":"unresolved","match_method":"no_verified_source_counterpart","match_note":null,"provider_identity":{"provider":"hadeethenc","id":null,"basis":[],"status":"absent","candidates":[]},"quotation_evidence":null,"arabic":{"text":"حَدَّثَنَا قُتَيْبَةُ، حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ، عَنِ ابْنِ الْمُنْكَدِرِ، سَمِعَ أُمَيْمَةَ بِنْتَ رُقَيْقَةَ، تَقُولُ بَايَعْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم فِي نِسْوَةٍ فَقَالَ لَنَا ‏\"‏ فِيمَا اسْتَطَعْتُنَّ وَأَطَقْتُنَّ ‏\"‏ ‏.‏ قُلْتُ اللَّهُ وَرَسُولُهُ أَرْحَمُ بِنَا مِنَّا بِأَنْفُسِنَا ‏.‏ قُلْتُ يَا رَسُولَ اللَّهِ بَايِعْنَا ‏.‏ قَالَ سُفْيَانُ تَعْنِي صَافِحْنَا ‏.‏ فَقَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏\"‏ إِنَّمَا قَوْلِي لِمِائَةِ امْرَأَةٍ كَقَوْلِي لاِمْرَأَةٍ وَاحِدَةٍ ‏\"‏ ‏.‏ ","citation":null,"references":[],"source_name":"Fawaz Ahmed Hadith API — Jami At Tirmidhi","source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/ara-tirmidhi/1597.json","source_snapshot":"fawaz-api-df57907be352","text_sha256":"2fac0730d889afeeef893a4343693799471744b9aa6169ceb0b82f4551e73d23","match_status":"source_supplied","scope":"source_excerpt","translation_origin":"unknown","source_record_id":"fawaz:df57907be352:tirmidhi:1597"},"english":null}}
