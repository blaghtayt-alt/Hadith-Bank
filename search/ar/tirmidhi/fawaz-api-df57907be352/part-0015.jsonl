":{"evidence":null,"name":null},"url":"https://raw.githubusercontent.com/fawazahmed0/hadith-api/df57907be35291c91ad6a6691180e22ca9920784/editions/eng-tirmidhi.json"},"text":"Ibn Al-Munkadir heard Umaimah bin Ruqaiqah saying:\"I pledged to the Messenger of Allah (ﷺ) along with some women. He said to us: 'In as much as you are able and capable.' I said: 'Allah and His Messenger are more merciful to us than we are to ourselves,' then I said: 'O Messenger of Allah take the pledge from us.'\" - Sufyan (one of the narrators) said: meaning: 'shake (hands) on it with us' - \"so the Messenger of Allah (ﷺ) said: 'My statement to one hundred women is like my statement to one.'\" [He said:] There are narrations on this topic from 'Aishah, from 'Abdullah bin 'Umar, and Asma' bint Yazid. ","translation_provenance":{"ai_translation":"unknown","basis":"Pinned publisher catalog attribution; extraction is not translation","origin":"unknown","source_declaration":null,"translator":null,"current_policy":{"classification":"human","basis":"explicit_owner_default_for_new_books_unless_source_declares_otherwise","decision_date_japan":"2026-11-11","policy_path":"catalog/provenance-policy.json"}}},{"comments":[{"embedded_narrations":"retained_here_pending_separate_boundary_review","scope":"source_compiler_note","source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/urd-tirmidhi/1597.json","text":"امام ترمذی کہتے ہیں: ۱- یہ حدیث حسن صحیح ہے، ہم اسے صرف محمد بن منکدر ہی کی روایت سے جانتے ہیں، سفیان ثوری، مالک بن انس اور کئی لوگوں نے محمد بن منکدر سے اسی جیسی حدیث روایت کی ہے، ۲- میں نے محمد بن اسماعیل بخاری سے اس حدیث کے بارے میں پوچھا تو انہوں نے کہا: میں امیمہ بنت رقیقہ کی اس کے علاوہ دوسری کوئی حدیث نہیں جانتا ہوں، ۳- امیمہ نام کی ایک دوسری عورت بھی ہیں جن کی رسول اللہ صلی اللہ علیہ وسلم سے ایک حدیث آئی ہے۔ ۴- اس باب میں عائشہ، عبداللہ بن عمر اور اسماء بنت یزید رضی الله عنہم سے بھی احادیث آئی ہیں۔"},{"scope":"provider_assessment_metadata","source_grade":{"grade":"Sahih","name":"Ahmad Muhammad Shakir"},"source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/urd-tirmidhi/1597.json","text":"Source assessment — Ahmad Muhammad Shakir: Sahih"},{"scope":"provider_assessment_metadata","source_grade":{"grade":"Sahih","name":"Al-Albani"},"source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/urd-tirmidhi/1597.json","text":"Source assessment — Al-Albani: Sahih"},{"scope":"provider_assessment_metadata","source_grade":{"grade":"Hasan Sahih","name":"Bashar Awad Maarouf"},"source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/urd-tirmidhi/1597.json","text":"Source assessment — Bashar Awad Maarouf: Hasan Sahih"},{"scope":"provider_assessment_metadata","source_grade":{"grade":"Isnaad Sahih","name":"Zubair Ali Zai"},"source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/urd-tirmidhi/1597.json","text":"Source assessment — Zubair Ali Zai: Isnaad Sahih"}],"grading":[{"grade":"Sahih","name":"Ahmad Muhammad Shakir"},{"grade":"Sahih","name":"Al-Albani"},{"grade":"Hasan Sahih","name":"Bashar Awad Maarouf"},{"grade":"Isnaad Sahih","name":"Zubair Ali Zai"}],"id":"fawaz:df57907be352:tirmidhi:1597:urd","language":"ur","match_status":"same_source_record","provider_numbers":{"arabicnumber":1597,"hadithnumber":1597,"reference":{"book":21,"hadith":59}},"quotation_status":"bounded","references":[{"canonical_mapping_status":"not_inferred","collection":"Jami At Tirmidhi","number":"1597","numbering_system":"fawaz_api_hadithnumber","provider_numbers":{"arabicnumber":1597,"hadithnumber":1597,"reference":{"book":21,"hadith":59}},"scope":"provider_entry_identity","source_citation":"Fawaz Ahmed Hadith API · urd-tirmidhi · entry 1597","url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/urd-tirmidhi/1597.json"}],"scope":"source_excerpt","script":"Arab","source":{"catalog_author_as_supplied":"Unknown","catalog_author_role":null,"catalog_source_as_supplied":"","entry_url_status":"documented_provider_route; exact imported bytes come from the pinned bulk snapshot","field":"text","json_pointer":"/hadiths/1605","name":"Fawaz Ahmed Hadith API — Jami At Tirmidhi — Urdu","project_credits_locator":"imports/web-fawaz-20261112/raw/00d51c7d58ec4d90106fc792ca0f1e400eaaad6a51527a4a69dd1d062a4f8283.txt.gz","project_credits_scope":"provider_project_level_credit_not_record_verified","provider_edition":"urd-tirmidhi","quotation_boundary_reason":null,"quotation_boundary_status":"bounded","quotation_kind":null,"record_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/urd-tirmidhi/1597.json","revision":"df57907be35291c91ad6a6691180e22ca9920784","snapshot_compression":"gzip","snapshot_path":"imports/web-fawaz-20261112/raw/e9e8b32660a8a9c4e25c6c344149e8c9429e1aa90e2d5414029b9727ffb53006.json.gz","snapshot_sha256":"e9e8b32660a8a9c4e25c6c344149e8c9429e1aa90e2d5414029b9727ffb53006","snapshot_stored_sha256":"184ca73ceeee5b5c14e4544f09841b6ed3be8a897cb82562431ad88620d3384b","source_report_alignment_note":null,"source_report_boundaries":null,"source_report_count":1,"source_text_sha256":"73cbfafa52e536166bdb6b7dccc4ed13ac5ec5a67559198651f8eb45a56432b3","text_spans":{"method":"literal_named_compiler_note_boundary_v1","note_embedded_narration_extraction":"pending; no additional occurrence inferred","notes":[[482,995]],"quotation":[0,482],"rule":"(?:امام\\s+)?ترمذی\\s+کہتے\\s+ہیں"},"translator":{"evidence":null,"name":null},"url":"https://raw.githubusercontent.com/fawazahmed0/hadith-api/df57907be35291c91ad6a6691180e22ca9920784/editions/urd-tirmidhi.json"},"text":"امیمہ بنت رقیقہ رضی الله عنہا کہتی ہیں کہ میں نے کئی عورتوں کے ساتھ رسول اللہ صلی اللہ علیہ وسلم سے بیعت کی، آپ نے ہم سے فرمایا: ”اطاعت اس میں لازم ہے جو تم سے ہو سکے اور جس کی تمہیں طاقت ہو“، میں نے کہا: اللہ اور اس کے رسول ہم پر خود ہم سے زیادہ مہربان ہیں، میں نے عرض کیا: اللہ کے رسول! ہم سے بیعت لیجئے ( سفیان بن عیینہ کہتے ہیں: ان کا مطلب تھا مصافحہ کیجئے ) ، رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”تم سو عورتوں کے لیے میرا قول میرے اس قول جیسا ہے جو ایک عورت کے لیے ہے“ ۱؎۔ ","translation_provenance":{"ai_translation":"unknown","basis":"Pinned publisher catalog attribution; extraction is not translation","origin":"unknown","source_declaration":null,"translator":null,"current_policy":{"classification":"human","basis":"explicit_owner_default_for_new_books_unless_source_declares_otherwise","decision_date_japan":"2026-11-11","policy_path":"catalog/provenance-policy.json"}}},{"comments":[{"embedded_narrations":"retained_here_pending_separate_boundary_review","scope":"source_compiler_note","source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/ben-tirmidhi/1597.json","text":" এ হাদীসটিকে আবূ ঈসা হাসান সহীহ বলেছেন। আমরা এ হাদীস প্রসঙ্গে শুধুমাত্র মুহাম্মাদ ইবনুল মুনকাদিরের সূত্রেই জেনেছি। সুফিয়ান সাওরী, মালিক ও অন্যান্যরা মুহাম্মাদ ইবনুল মুনকাদিরের সূত্রে এ হাদীসের মতই বর্ণনা করেছেন। আমি এ হাদীস বিষয়ে মুহাম্মাদ (বুখারী)-কে প্রশ্ন করলে তিনি বলেন, উমাইমা বিনতু রুকাইকা (রাঃ) হতে বর্ণিত এটি ব্যতীত আর কোন হাদীস আছে কি-না তা আমার জানা নেই। উমাইমা (রাঃ) নামক আরো একজন মহিলা আছেন যিনি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম হতে হাদীস বর্ণনা করেছেন।"},{"scope":"provider_assessment_metadata","source_grade":{"grade":"Sahih","name":"Ahmad Muhammad Shakir"},"source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/ben-tirmidhi/1597.json","text":"Source assessment — Ahmad Muhammad Shakir: Sahih"},{"scope":"provider_assessment_metadata","source_grade":{"grade":"Sahih","name":"Al-Albani"},"source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9