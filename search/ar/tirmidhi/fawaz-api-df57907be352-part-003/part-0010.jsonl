on","origin":"unknown","source_declaration":null,"translator":null,"current_policy":{"classification":"human","basis":"explicit_owner_default_for_new_books_unless_source_declares_otherwise","decision_date_japan":"2026-11-11","policy_path":"catalog/provenance-policy.json"}}},{"comments":[{"embedded_narrations":"retained_here_pending_separate_boundary_review","scope":"source_compiler_note","source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/ben-tirmidhi/3956.json","text":"আবূ ঈসা বলেন, এ হাদীসটি হাসান। আমার দৃষ্টিতে এ হাদীসটি প্রথমোক্ত হাদীসের চেয়ে বেশী সহীহ। সাঈদ আল-মাকুবুরী (রহঃ) আবূ হুরাইরাহ (রাযিঃ) হতে হাদীস শুনেছেন। তিনি তার পিতার সনদে আবূ হুরাইরাহ (রাযিঃ) হতে বহু হাদীস রিওয়ায়াত করেছেন। এ হাদীস সুফইয়ান সাওরী প্রমুখ হিশাম ইবনু সা'দ হতে, তিনি সাঈদ আল-মাকবুরী হতে, তিনি আবূ হুরাইরাহ (রাযিঃ) হতে, তিনি নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম হতে এই সনদে আবূ আমির হতে হিশামের সনদে বর্ণিত হাদীসের একই রকম রিওয়ায়াত করেছেন।"},{"scope":"provider_assessment_metadata","source_grade":{"grade":"Hasan","name":"Ahmad Muhammad Shakir"},"source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/ben-tirmidhi/3956.json","text":"Source assessment — Ahmad Muhammad Shakir: Hasan"},{"scope":"provider_assessment_metadata","source_grade":{"grade":"Hasan","name":"Al-Albani"},"source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/ben-tirmidhi/3956.json","text":"Source assessment — Al-Albani: Hasan"},{"scope":"provider_assessment_metadata","source_grade":{"grade":"Hasan Sahih","name":"Bashar Awad Maarouf"},"source_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/ben-tirmidhi/3956.json","text":"Source assessment — Bashar Awad Maarouf: Hasan Sahih"}],"grading":[{"grade":"Hasan","name":"Ahmad Muhammad Shakir"},{"grade":"Hasan","name":"Al-Albani"},{"grade":"Hasan Sah