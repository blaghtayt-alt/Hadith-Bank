ort_boundaries":null,"source_report_count":1,"source_text_sha256":"d09c31eebd49a982bb93abceffef213c5720b7f84092ed494fe4dfa35466aa7a","text_spans":{"notes":[],"quotation":[0,389]},"translator":{"evidence":null,"name":null},"url":"https://raw.githubusercontent.com/fawazahmed0/hadith-api/df57907be35291c91ad6a6691180e22ca9920784/editions/ben-nasai.json"},"text":"ওয়াসিল ইবন আবদুল আ'লা (রহঃ) ... ইবন আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর জন্য রাতে মুনাক্কা ভিজিয়ে রাখা হতো। পরে তিনি তা একটি মশকে ভরে রাখতেন এবং দ্বিতীয় দিন তা পান করতেন, পরে তৃতীয় দিনেও পান করতেন। তৃতীয় দিনের শেষ সময়ে তিনি তা অন্যদেরকে পান করিয়ে দিতেন এবং নিজেও পান করতেন। যদি তারপরেও ভাের পর্যন্ত কিছু থাকতো, তবে তিনি তা ফেলে দিতেন।","translation_provenance":{"ai_translation":"unknown","basis":"Pinned publisher catalog attribution; extraction is not translation","origin":"unknown","source_declaration":null,"translator":null,"current_policy":{"classification":"human","basis":"explicit_owner_default_for_new_books_unless_source_declares_otherwise","decision_date_japan":"2026-11-11","policy_path":"catalog/provenance-policy.json"}}}],"source_locator":{"provider_book":"nasai","revision":"df57907be35291c91ad6a6691180e22ca9920784","typed_hadithnumber":"5739","versions":{"ara":{"json_pointer":"/hadiths/5745","path":"imports/web-fawaz-20261112/raw/c705983c19bb089c87cd6531aff609bd94d862183ed0859115b0ff991826a956.json.gz","sha256":"c705983c19bb089c87cd6531aff609bd94d862183ed0859115b0ff991826a956"},"ben":{"json_pointer":"/hadiths/5745","path":"imports/web-fawaz-20261112/raw/11a4ad2a41ec2d259f7fd9b5959496bf5cf8424cdf0944bea197927b68d59d72.json.gz","sha256":"11a4ad2a41ec2d259f7fd9b5959496bf5cf8424cdf0944bea197927b68d59d72"},"eng":{"json_pointer":"/hadiths/5745","path":"imports/web-fawaz-20261112/raw/4f2aaca4229b96210fdaa887915c69ba99dda8726816856cc8660e996b6b3a1f.json.gz","sha256":"4f2aaca4229b96210fdaa887915c69ba99dda8726816856cc8660e996b6b3a1f"},"urd":{"json_pointer":"/h