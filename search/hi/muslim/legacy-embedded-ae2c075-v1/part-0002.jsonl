{"schema_version":"hadith-bank-search-record-v1","id":"legacy.hi.6cf38f02399ad9c517f69568","language":"hi","source_language_code":"hi","book_key":"muslim","edition":"legacy-embedded-ae2c075-v1","source_id":"legacy-hi-muslim","provider_entry_id":"258","title":"Sahih Muslim 1438","text_arabic":"‏مَنْ صَلَّى الْبَرْدَيْنِ دَخَلَ الْجَنَّةَ\n\n‏توضيح: البردان: صلاتا الفجر والعصر.","text_translation":"अबू मूसा अशअरी रज़ियल्लाहु अनहु का वर्णन है, वह कहते हैं कि अल्लाह के रसूल सल्लल्लाहु अलैहि व सल्लम ने फ़रमाया : \"जिसने दो ठंडे समय की नमाज़ें पढ़ीं, वह जन्नत में जाएगा।\"","number":{"source_entry_id":"258","in_book":"1438","canonical":null,"numbering_scheme":"as_cited_in_selected_source"},"narrator":{"name":null,"basis":"not_supplied","evidence":null},"source":{"name":"Older Hadith Bank — hi — Sahih Muslim","work_title":"Sahih Muslim 1438","url":"https://github.com/blaghtayt-alt/iman-companion/blob/ae2c07599767ee7182c40d3ff2264fcdac98d182/materials/hadith/hi.json","record_url":null,"original_file":"materials/legacy-hi-muslim/source-bundle.json","sha256":"41829cdda45637298f4b9edabfaf4d92a3fa8a9a6fa33b8a08bc3ae2ae7f477f","record_locator":{"path":"materials/legacy-hi-muslim/records.json","json_pointer":"/100"},"format":"json","original_metadata":{"title":"Sahih Muslim 1438","url":"https://github.com/blaghtayt-alt/iman-companion/blob/ae2c07599767ee7182c40d3ff2264fcdac98d182/materials/hadith/hi.json","legacy_document":{"repository":"blaghtayt-alt/iman-companion","revision":"ae2c07599767ee7182c40d3ff2264fcdac98d182","path":"materials/hadith/hi.json","sha256":"dd3333fa68be989f2fcd4ee2123ef2a371cc8920d8ec03aa103df3374390be42","git_blob_sha":"6674fb955ad46310ca8898755aa8bdcdfe6fa4cc","json_pointer":"/items/161/text","code_points":[0,168],"excerpt_sha256":"b421f9f204692233b17ceab009ba5486714775f5159cfd5aa9a38154cb677daa"},"byte_identical_local_aliases":[],"historical_metadata":{"id":258,"text":"अबू मूसा अशअरी रज़ियल्लाहु अनहु का वर्णन है, वह कहते हैं कि अल्लाह के रसूल सल्लल्लाहु अलैह