ed/075-sources/PARAGRAPHS-AND-SEMANTIC-RUNS658.json","original_locator":{"path":"materials/tadabbur/ja/extended/075-sources/PARAGRAPHS-AND-SEMANTIC-RUNS658.json","git_blob_sha":"c9b471a138664182f37a834788aa26a2b583142c","sha256":"5d724da6742be81fbd2fbd79ee00f444b98dc43b624babb006aee14c5f73cc16","json_pointer":"/282/text","char_start":161,"char_end":210,"offset_unit":"Unicode code points in decoded JSON string","decoded_utf8_start":483,"decoded_utf8_end":630,"text_sha256":"feefa7f4c0cfb615f6b5931c645ed4b14df3d285af8503f0757bc5aa0d83ca1f"},"metadata_locator":{"path":"materials/tadabbur/ja/extended/075-sources/NON-QURAN-SOURCE-RECORDS658.json","json_pointer":"/9"},"arabic_locator":null,"source_classification":"hadith_meaning_excerpt","is_excerpt":true,"context_note":"This is an explicitly bounded source excerpt, not the complete Hadith. Separate occurrences are not distinct-Hadith counts.","original_source_metadata":{"id":"H10","sourceIds":["S11","S12"],"title":"章末の問いへの応答","classification":"新たに作成したハディースの意味訳","paragraphIds":["word/document.xml:p0283"],"unitKeys":["75:40"],"reference":"Sunan Abi Dawud884; Book2 Hadith494; English numbering883","narrator":"ムーサー・イブン・アビー・アーイシャが、名の記されていない人から伝える","sourceAttributedGrade":"掲載資料のアル＝アルバーニー評価は真正。","selectedJapaneseMeaningOrQuote":["あなたはあらゆる欠点を超越しておられます。もちろん、あなたには死者をよみがえらせる御力があります。"],"bibliographyParagraphIds":["word/document.xml:p0330","word/document.xml:p0331","word/document.xml:p0332"],"bibliographyText":["本書で新たに作成した意味訳。典拠：アブー・ダーウード884。伝承全文を確認し、この応答の意味をアラビア語から訳しました。公表された日本語訳からの引用ではありません。前半はアッラーに欠点がないことを讃える言葉で、後半は直前の問いに対し、死者を復活させる御力を肯定しています。「死者をよみがえらせる御力があります」は、この短い肯定が指す内容を文脈に沿って明示したものです。この応答はハディースの言葉であり、クルアーン第75章40節の本文には含まれません。884は、ある人がこの言葉を預言者から聞いたと述べる伝承です。ここでは、すべての読誦者に対する命令としては記していません。既存の日本語刊行物の探索範囲と結果は、別添の出典記録に示します。"],"links":[{"paragraph":331,"label":"アラビア語本文と典拠","url":"https://sunnah.com/abudawud:884"},{"paragraph":332,"label":"アラビア語原典","url":"https://sunnah.com/abudawud:884"}],"ArabicParentURLs":["https://sunnah.com/abudawud:884","https://sunnah.com/abudawud:887"],"contextAndVariantNote":"884は、ある人が預言者から聞いた応答を述べる伝承です。887には読誦者への命令形がありますが、応答の文言も異なり、掲載資料のアル＝アルバーニー評価は弱い伝承です。その命令形を884に加えてはいません。","requiredPublishedNoteIds":[],"quotationContextRequired":true},"original_context":"こうして結びが章の冒頭と出会います。章は、復活の日の重大さを示すことから始まり、骨を集めることなどあり得ないという考えに向き合いました。そして、人を最初の創造へと連れ戻し、ただ言葉を繰り返すのではなく、確信を持って問いに答えられるようにしたのです。この節への応答として、預言者（アッラーの祝福と平安がありますように）から『あなたはあらゆる欠点を超越しておられます。もちろん、あなたには死者をよみがえらせる御力があります。』という言葉を聞いたことが伝えられています［アブー・ダーウード：884］。この節に応えることは、章が示してきた御力を認めることになります。"}},"translator":{"name":null,"evidence":null},"translation_provenance":{"origin":"unknown","label":"Unknown","ai_translation":"unknown","basis":"Copied Iman/old-bank material: owner confirmation pending. Historical source wording and authorship metadata remain preserved.","human_involvement":"not_established","evidence_ids":[],"scope_note":"Original source metadata is preserved; current translation classification follows the recorded provenance evidence and owner policy.","policy_path":null,"current_policy":{"classification":"unknown","basis":"owner_withheld_confirmation_of_old_bank_copies","decision_date_japan":"2026-11-11","policy_path":"catalog/provenance-policy.json"}},"extraction":{"ocr_used":false,"method":"structured_source_quote","classification":"digital_text","evidence_fields":["extraction.ocr_used"],"conflicting_evidence":false},"topic_tags":[],"editorial_tags":[],"source_headings":[],"review":{"status":"source_extracted","independent_pro_qc":"not_asserted","release_status":"source_candidate","release_eligible":false,"certified_release_eligible":false,"issues":[]},"commentary":{"arabic":null,"translation":"This is an explicitly bounded source excerpt, not the complete Hadith. Separate occurrences are not distinct-Hadith counts.\n884は、ある人が預言者から聞いた応答を述べる伝承です。887には読誦者への命令形がありますが、応答の文言も異なり、掲載資料のアル＝アルバーニー評価は弱い伝承です。その命令形を884に加えてはいません。"},"benefits":null,"footnotes":[],"references":{"items":[{"book_key":"abu-dawud","collection":"Sunan Abi 