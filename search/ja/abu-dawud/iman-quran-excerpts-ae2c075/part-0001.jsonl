nter":"/units/1/blocks/1/text","char_start":268,"char_end":307,"offset_unit":"Unicode code points in decoded JSON string","decoded_utf8_start":804,"decoded_utf8_end":921,"text_sha256":"16e8d79d1f4ac48822257178ec8d06f86fb64571a25fc6903c9949e290c4d402"},"metadata_locator":{"path":"materials/tadabbur/fatiha-extended/ja/reading.json","json_pointer":"/units/1/blocks/1"},"arabic_locator":null,"source_classification":"hadith_excerpt","is_excerpt":true,"context_note":"This is an explicitly bounded source excerpt, not the complete Hadith. Separate occurrences are not distinct-Hadith counts.","original_source_metadata":{"selection_method":"reviewed_printed_quote_boundary","quote_index":0,"kind":"published_excerpt"},"original_context":"この章は、アッラーの御名をもって始まる。最初の前置詞バーには、二つの説明によると、共にあること、または助けを求めることという意味がある。しもべは、歩みの最初から、自分だけに任されることのないよう願い、アッラーに助けを求めているかのようである。クルアーンに向き合い、主に向かって進む中で、御名の恵みが自分に伴うことを望むのである。手段が尽きてから初めて主を必要とすると認めるのではない。また、アッラーの助けに頼らず、自力だけで歩みを始め、全うできると考えるのでもない。この意味に近づけてくれるのが、預言者の祈りである。公刊日本語訳では、「アッラーよ、あなたのご慈悲こそを願います。私を一瞬たりとも見放さないで下さい。」原文では、自分自身だけに任されないことを願っている。人がわずかだと思うほどの短い時間にも、主を必要としない瞬間はないのである。","original_arabic_reference":{"source_token":"H0","reference":"abudawud:5090","scope":"original_lesson_reference; published parallels may differ","locator":{"path":"materials/tadabbur/fatiha-extended/uz/sources.json","json_pointer":"/quotationRoutes/9"}}}},"translator":{"name":null,"evidence":null},"translation_provenance":{"origin":"unknown","label":"Unknown","ai_translation":"unknown","basis":"Copied Iman/old-bank material: owner confirmation pending. Historical source wording and authorship metadata remain preserved.","human_involvement":"not_established","evidence_ids":[],"scope_note":"Original source metadata is preserved; current translation classification follows the recorded provenance evidence and owner policy.","policy_path":null,"current_policy":{"classification":"unknown","basis":"owner_withheld_confirmation_of_old_bank_copies","decision_date_japan":"2026-11-11","polic