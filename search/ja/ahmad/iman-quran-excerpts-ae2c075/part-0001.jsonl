{"schema_version":"hadith-bank-search-record-v1","id":"iman-quran-ja-fatiha-h14","language":"ja","source_language_code":"ja","book_key":"ahmad","edition":"iman-quran-excerpts-ae2c075","source_id":"quran-excerpts-ja-ahmad","provider_entry_id":"H14","title":"Hadith excerpt — Al-Fatiha study / H14","text_arabic":null,"text_translation":"アッラーよ、私はあなたのしもべです。あなたの男のしもべの息子で、あなたの女のしもべの息子です。","number":{"source_entry_id":"H14","in_book":"3712","canonical":null,"numbering_scheme":"as_cited_in_source"},"narrator":{"name":null,"evidence":null},"source":{"name":"Japanese Quran-study Hadith excerpts — Musnad Ahmad","work_title":"Japanese Hadith excerpts in Quran-study materials","url":"https://github.com/blaghtayt-alt/iman-companion/blob/ae2c07599767ee7182c40d3ff2264fcdac98d182/materials/tadabbur/fatiha-extended/ja/reading.json","record_url":"https://github.com/blaghtayt-alt/iman-companion/blob/ae2c07599767ee7182c40d3ff2264fcdac98d182/materials/tadabbur/fatiha-extended/ja/reading.json","original_file":"materials/quran-excerpts-ja-ahmad/source-bundle.json","sha256":"e4b6bd8778276f9e59c7ab59f4fa81522ef7bcabc429f0b9522edc3d741b9c6c","record_locator":{"path":"materials/quran-excerpts-ja-ahmad/records.json","json_pointer":"/0"},"format":"json","original_metadata":{"title":"Japanese Hadith excerpts in Quran-study materials","repository":"blaghtayt-alt/iman-companion","commit":"ae2c07599767ee7182c40d3ff2264fcdac98d182","family":"fatiha","source_token":"H14","url":"https://github.com/blaghtayt-alt/iman-companion/blob/ae2c07599767ee7182c40d3ff2264fcdac98d182/materials/tadabbur/fatiha-extended/ja/reading.json","record_url":"https://github.com/blaghtayt-alt/iman-companion/blob/ae2c07599767ee7182c40d3ff2264fcdac98d182/materials/tadabbur/fatiha-extended/ja/reading.json","original_locator":{"path":"materials/tadabbur/fatiha-extended/ja/reading.json","git_blob_sha":"7003f0086a7fe08c9ded3a14eb6ef21fdf3b0702","sha256":"75bd53e355b05ac2e37b814dcb9e92d341cc9a2cb09229907370f62b3a583d1d","json_pointer":