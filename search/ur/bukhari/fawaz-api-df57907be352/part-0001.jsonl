یاد ایک مخملی چادر کے بستر پر لیٹا ہوا تھا اور کچھ گنگنا رہا تھا۔ ابن صیاد کی ماں نے نبی کریم صلی اللہ علیہ وسلم کو کھجور کے تنوں سے چھپ کر آتے ہوئے دیکھ لیا اور اسے بتا دیا کہ اے صاف! ( یہ اس کا نام تھا ) محمد آ رہے ہیں۔ چنانچہ وہ متنبہ ہو گیا۔ نبی کریم صلی اللہ علیہ وسلم نے فرمایا کہ اگر اس کی ماں اسے متنبہ نہ کرتی تو بات صاف ہو جاتی۔","translation_provenance":{"ai_translation":"unknown","basis":"Pinned publisher catalog attribution; extraction is not translation","origin":"unknown","source_declaration":null,"translator":null,"current_policy":{"classification":"human","basis":"explicit_owner_default_for_new_books_unless_source_declares_otherwise","decision_date_japan":"2026-11-11","policy_path":"catalog/provenance-policy.json"}}}],"source_locator":{"provider_book":"bukhari","revision":"df57907be35291c91ad6a6691180e22ca9920784","typed_hadithnumber":"6174","versions":{"ara":{"json_pointer":"/hadiths/6197","path":"imports/web-fawaz-20261112/raw/e34a3402889ca378871da3c5984b7875c680920e93f1c8738ac7afe502179562.json.gz","sha256":"e34a3402889ca378871da3c5984b7875c680920e93f1c8738ac7afe502179562"},"eng":{"json_pointer":"/hadiths/6197","path":"imports/web-fawaz-20261112/raw/b3a10b8d50949e86cec82b0d323ce0eae3e2f713fa2f3daa5361638feb795988.json.gz","sha256":"b3a10b8d50949e86cec82b0d323ce0eae3e2f713fa2f3daa5361638feb795988"},"urd":{"json_pointer":"/hadiths/6197","path":"imports/web-fawaz-20261112/raw/9b7a2741bc92714c7042e035749aaed1635168e9be72f8861020dc8c59ce873e.json.gz","sha256":"9b7a2741bc92714c7042e035749aaed1635168e9be72f8861020dc8c59ce873e"}}},"counterparts":{"schema":"hadith-bank-counterpart-link-v1","status":"unresolved","match_method":"no_verified_source_counterpart","match_note":null,"provider_identity":{"provider":"hadeethenc","id":null,"basis":[],"status":"absent","candidates":[]},"quotation_evidence":null,"arabic":null,"english":null}}
