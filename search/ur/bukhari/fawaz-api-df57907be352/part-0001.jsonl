0871526e0a3300751d8dcbac4913678aaf9aee5069397a95469d43bafdba4a3","source_report_alignment_note":null,"source_report_boundaries":null,"source_report_count":1,"source_text_sha256":"193eacd516e8184b147f45818a7082f832335ceb1dc3e759de773e9c4194860d","text_spans":{"notes":[],"quotation":[0,769]},"translator":{"evidence":null,"name":null},"url":"https://raw.githubusercontent.com/fawazahmed0/hadith-api/df57907be35291c91ad6a6691180e22ca9920784/editions/urd-bukhari.json"},"text":"سالم نے بیان کیا کہ میں نے عبداللہ بن عمر رضی اللہ عنہما سے سنا، انہوں نے بیان کیا کہ اس کے بعد رسول اللہ صلی اللہ علیہ وسلم ابی بن کعب انصاری رضی اللہ عنہ کو ساتھ لے کر اس کھجور کے باغ کی طرف روانہ ہوئے جہاں ابن صیاد رہتا تھا۔ جب نبی کریم صلی اللہ علیہ وسلم باغ میں پہنچے تو آپ نے کھجور کی ٹہنیوں میں چھپنا شروع کیا۔ نبی کریم صلی اللہ علیہ وسلم چاہتے تھے کہ اس سے پہلے کہ وہ دیکھے چھپ کر کسی بہانے ابن صیاد کی کوئی بات سنیں۔ ابن صیاد ایک مخملی چادر کے بستر پر لیٹا ہوا تھا اور کچھ گنگنا رہا تھا۔ ابن صیاد کی ماں نے نبی کریم صلی اللہ علیہ وسلم کو کھجور کے تنوں سے چھپ کر آتے ہوئے دیکھ لیا اور اسے بتا دیا کہ اے صاف! ( یہ اس کا نام تھا ) محمد آ رہے ہیں۔ چنانچہ وہ متنبہ ہو گیا۔ نبی کریم صلی اللہ علیہ وسلم نے فرمایا کہ اگر اس کی ماں اسے متنبہ نہ کرتی تو بات صاف ہو جاتی۔","translation_provenance":{"ai_translation":"unknown","basis":"Pinned publisher catalog attribution; extraction is not translation","origin":"unknown","source_declaration":null,"translator":null,"current_policy":{"classification":"human","basis":"explicit_owner_default_for_new_books_unless_source_declares_otherwise","decision_date_japan":"2026-11-11","policy_path":"catalog/provenance-policy.json"}}},{"comments":[],"grading":[],"id":"fawaz:df57907be352:bukhari:6174:ben","language":"bn","match_status":"same_source_record","provider_numbers":{"arabicnumber":6174,"hadithnumber":6174,"reference":{"book":0,"hadith":0}},"quotation_status":"bounded","references":[{"canonical_mapping_status":"not_inferred","collection":"Sahih al Bukhari","number":"6174","numbering_system":"fawaz_api_hadithnumber","provider_numbers":{"arabicnumber":6174,"hadithnumber":6174,"reference":{"book":0,"hadith":0}},"scope":"provider_entry_identity","source_citation":"Fawaz Ahmed Hadith API · ben-bukhari · entry 6174","url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/ben-bukhari/6174.json"}],"scope":"source_entry","script":"Beng","source":{"catalog_author_as_supplied":"Unknown","catalog_author_role":null,"catalog_source_as_supplied":"","entry_url_status":"documented_provider_route; exact imported bytes come from the pinned bulk snapshot","field":"text","json_pointer":"/hadiths/6197","name":"Fawaz Ahmed Hadith API — Sahih al Bukhari — Bengali","project_credits_locator":"imports/web-fawaz-20261112/raw/00d51c7d58ec4d90106fc792ca0f1e400eaaad6a51527a4a69dd1d062a4f8283.txt.gz","project_credits_scope":"provider_project_level_credit_not_record_verified","provider_edition":"ben-bukhari","quotation_boundary_reason":null,"quotation_boundary_status":"bounded","quotation_kind":null,"record_url":"https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@df57907be35291c91ad6a6691180e22ca9920784/editions/ben-bukhari/6174.json","revision":"df57907be35291c91ad6a6691180e22ca9920784","snapshot_compression":"gzip","snapshot_path":"imports/web-fawaz-20261112/raw/8f5e574422e2c2eecaa42bcd80ce90d9a1f29c82c2143bc789965dc364d91156.json.gz","snapshot_sha256":"8f5e574422e2c2eecaa42bcd80ce90d9a1f29c82c2143bc789965dc364d91156","snapshot_stored_sha256":"d4abce54f9c921b1a5a4c9470c865d75dc079820c51519c859b8521a43805562","source_report_alignment_note":null,"source_report_boundaries":null,"source_report_count":1,"source_text_sha256":"1e9aefe219dbe35c77105d53e5db35149efd7b1b3234b33579b1555c1766695d","text_spans":{"notes":[],"quotation":[0,965]},"translator":{"evidence":null,"name":null},"url":"https://raw.githubusercontent.com/fawazahmed0/hadith-api/df57907be35291c91ad6a6691180e22ca9920784/editions/ben-bukhari.json"},"text":"সালিম (রহ.) বলেন, এরপর আমি ‘আবদুল্লাহ ইবনু ‘উমার (রাঃ)-কে বলতে শুনেছি যে, এ ঘটনার পর একদিন রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এবং উবাই ইবনু কা‘ব সেই খেজুর বাগানের দিকে রওয়ানা হলেন, যেখানে ইবনু সাইয়্যাদ ছিল। অবশেষে যখন রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বাগানে প্রবেশ করলেন, তখন তিনি খেজুরের গাছের আড়ালে চলতে লাগলেন। তাঁর উদ্দেশ্য ছিল যে, ইবনু সাইয়্যাদ তাঁকে দেখার আগেই যেন তিনি তার কিছু কথাবার্তা শুনে নিতে পারেন। এ সময় ইবনু সাইয়্যাদ তার বিছানায় একখানা চাদর গায়ে দিয়ে শুয়েছিল। আর তার চাদরের মধ্য হতে বিড়বিড় শব্দ শুনা যাচ্ছিল। ইতোমধ্যে ইবনু সাইয়্যাদের মা নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে দেখল যে, তিনি খেজুরের গাছের আড়ালে লুকিয়ে লুকিয়ে আসছেন। তখন তার মা তাকে ডেকে বললঃ ওহে সাফ্! -এটা ছিল তার ডাক নাম- এই যে, মুহাম্মাদ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম। তখন ইবনু সাইয়্যাদ চুপ হল। তখন রাসূলূল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেনঃ যদি তার মা তাকে সতর্ক না করতো তবে তার (ব্যাপার) প্রকাশ পেয়ে যেতো। [১১৫৫] (আধুনিক প্রকাশনী- ৫৭৩৩, ইসলামিক ফাউন্ডেশন)","translation_provenance":{"ai_translation":"unknown","basis":"Pinned publisher catalog attribution; extraction is not translation","origin":"unknown","source_declaration":null,"translator":null,"current_policy":{"classification":"human","basis":"explicit_owner_default_for_new_books_unless_source_declares_otherwise","decision_date_japan":"2026-11-11","policy_path":"catalog/provenance-policy.json"}}}],"source_locator":{"provider_book":"bukhari","revision":"df57907be35291c91ad6a6691180e22ca9920784","typed_hadithnumber":"6174","versions":{"ara":{"json_pointer":"/hadiths/6197","path":"imports/web-fawaz-20261112/raw/e34a3402889ca378871da3c5984b7875c680920e93f1c8738ac7afe502179562.json.gz","sha256":"e34a3402889ca378871da3c5984b7875c680920e93f1c8738ac7afe502179562"},"ben":{"json_pointer":"/hadiths/6197","path":"imports/web-fawaz-20261112/raw/8f5e574422e2c2eecaa42bcd80ce90d9a1f29c82c2143bc789965dc364d91156.json.gz","sha256":"8f5e574422e2c2eecaa42bcd80ce90d9a1f29c82c2143bc789965dc364d91156"},"eng":{"json_pointer":"/hadiths/6197",