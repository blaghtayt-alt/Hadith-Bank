56":"0df646634b35001760b99f69f373d89cc669bd48fcd211556a3f84cb2bf9c1d9","json_pointer":"/units/1/blocks/1/text","char_start":560,"char_end":643,"offset_unit":"Unicode code points in decoded JSON string","decoded_utf8_start":1035,"decoded_utf8_end":1188,"text_sha256":"b95451c56f1148cce685384dce20b96a7398a6e144aaf0e1e244641e85446d73"},"metadata_locator":{"path":"materials/tadabbur/fatiha-extended/uz/sources.json","json_pointer":"/quotationRoutes/9"},"arabic_locator":{"path":"materials/tadabbur/ar/extended/001.json","git_blob_sha":"70e5bd721380eaa6cde29397529ed99e04d30577","sha256":"b5e96ac715e85e8ebc2eec31b4441484e9d345758207474d4c6ac5bb45510ce8","json_pointer":"/entries/1:1/blocks/1/text","char_start":374,"char_end":421,"offset_unit":"Unicode code points in decoded JSON string","decoded_utf8_start":679,"decoded_utf8_end":765,"text_sha256":"00ae681af8d789068ed4794b964994d11e9ab074cac50d361c52861e8b6f20d0"},"source_classification":"hadith_excerpt","is_excerpt":true,"context_note":"This is an explicitly bounded source excerpt, not the complete Hadith. Separate occurrences are not distinct-Hadith counts.","original_source_metadata":{"id":"H0","unit":"1:1","block":1,"text":"Аллоҳим, раҳматингдан умидворман. Мени кўз очиб-юмгунча ҳам ўз ҳолимга ташлаб қўйма","blockBounds":{"cp":[560,643],"utf16":[560,643],"decodedUTF8Bytes":[1035,1188]},"readerBounds":{"cp":[5619,5702],"utf16":[5619,5702],"decodedUTF8Bytes":[10358,10511]},"kind":"unchanged_published_Uzbek_Hadith","parentId":"WEB0","sourceField":"flatDOMPublishedParent","parentBounds":{"cp":[277,360],"utf16":[277,360],"decodedUTF8Bytes":[482,635]},"originalLocator":{"index":0,"unit":"1:1","block":1,"originalArabicQuote":"«اللهم رحمتك أرجو، فلا تكلني إلى نفسي طرفة عين»","reference":"abudawud:5090"},"qualification":"Fullpublisherparent/meaningfulnotes/actualattributionprovided. OriginalcanonicalArabic/narratorandactualpublishedparallelkeptdistinct;no sourcewordsrepaired."},"original_context":"Сура Аллоҳнинг номи билан бошланади. Арабчадаги «бо» ҳарфи зикр қилинган икки талқинга кўра ҳамроҳлик ёки ёрдам сўраш маъносини билдиради. Гўё банда бутун йўлини ўз ҳолига ташлаб қўйилмасликни сўраб бошлайди. У илк лаҳзадан Аллоҳдан ёрдам сўрайди, Қуръонга юзланиши ва Рабби сари юришида Унинг номи баракоти ҳамроҳ бўлишини умид қилади. Муҳтожлигини тан олиш учун барча воситалар узилиб қолишини кутмайди. Ўзини Аллоҳнинг ёрдамисиз йўлни бошлаб, охиригача ета оладиган мустақил зот деб ҳам билмайди. Пайғамбаримизнинг қуйидаги дуоси бу маънони яқинлаштиради: «Аллоҳим, раҳматингдан умидворман. Мени кўз очиб-юмгунча ҳам ўз ҳолимга ташлаб қўйма». Киши арзимас деб билган қисқа фурсатда ҳам Аллоҳга муҳтожлик узилмайди.","original_arabic_reference":{"source_token":"H0","reference":"abudawud:5090","scope":"original_lesson_reference; published parallels may differ","locator":{"path":"materials/tadabbur/fatiha-extended/uz/sources.json","json_pointer":"/quotationRoutes/9"}}}},"translator":{"name":null,"evidence":null},"translation_provenance":{"origin":"unknown","label":"Unknown","ai_translation":"unknown","basis":"Copied Iman/old-bank material: owner confirmation pending. Historical source wording and authorship metadata remain preserved.","human_involvement":"not_established","evidence_ids":[],"scope_note":"Original source metadata is preserved; current translation classification follows the recorded provenance evidence and owner policy.","policy_path":null},"extraction":{"ocr_used":false,"method":"structured_source_quote","classification":"digital_text","evidence_fields":["extraction.ocr_used"],"conflicting_evidence":false},"topic_tags":[],"editorial_tags":[],"source_headings":[],"review":{"status":"source_extracted","independent_pro_qc":"not_asserted","release_status":"source_candidate","release_eligible":false,"certified_release_eligible":false,"issues":[]},"commentary":{"arabic":null,"translation":"This is an explicitly bounded source excerpt, not the complete Hadith. Separate occurrences are not distinct-Had