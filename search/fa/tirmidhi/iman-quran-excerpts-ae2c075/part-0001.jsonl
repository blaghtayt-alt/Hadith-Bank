سان، ثنای این آیه به بزرگداشتِ حکمی می‌انجامد که بنده به آن بازمی‌گردد؛ پیش از آنکه در آیۀ بعد، بندگی و یاری خواستنِ خود را اعلام کند.","original_arabic_reference":{"source_token":"H12","reference":"tirmidhi:2314","scope":"original_lesson_reference; published parallels may differ","locator":{"path":"materials/tadabbur/fatiha-extended/uz/sources.json","json_pointer":"/quotationRoutes/57"}}}},"translator":{"name":null,"evidence":null},"translation_provenance":{"origin":"unknown","label":"Unknown","ai_translation":"unknown","basis":"Copied Iman/old-bank material: owner confirmation pending. Historical source wording and authorship metadata remain preserved.","human_involvement":"not_established","evidence_ids":[],"scope_note":"Original source metadata is preserved; current translation classification follows the recorded provenance evidence and owner policy.","policy_path":null},"extraction":{"ocr_used":false,"method":"structured_source_quote","classification":"digital_text","evidence_fields":["extraction.ocr_used"],"conflicting_evidence":false},"topic_tags":[],"editorial_tags":[],"source_headings":[],"review":{"status":"source_extracted","independent_pro_qc":"not_asserted","release_status":"source_candidate","release_eligible":false,"certified_release_eligible":false,"issues":[]},"commentary":{"arabic":null,"translation":"This is an explicitly bounded source excerpt, not the complete Hadith. Separate occurrences are not distinct-Hadith counts."},"benefits":null,"footnotes":[],"references":{"items":[{"book_key":"tirmidhi","collection":"Jami al-Tirmidhi","number":"2314","scope":"main_quote","source_citation":"tirmidhi:2314","numbering_scheme":"as_cited_in_source","verification":"explicit_source_citation_not_independent_edition_alignment","locator":{"path":"materials/tadabbur/fatiha-extended/uz/sources.json","git_blob_sha":"6008bcc8c3ff1937a46093b955070892cc27b90e","sha256":"ea10b825576fb78ef5ea7d96aad8c6515360b187d8b5ce8b786be494c10b984f","json_pointer":"/quotationRoutes