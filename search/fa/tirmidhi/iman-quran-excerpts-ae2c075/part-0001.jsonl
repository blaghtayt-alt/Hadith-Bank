8411f1b63c997866c844ea","json_pointer":"/units/6/blocks/1/text","char_start":634,"char_end":674,"offset_unit":"Unicode code points in decoded JSON string","decoded_utf8_start":1155,"decoded_utf8_end":1230,"text_sha256":"b01d752dda04d9585701eb4591c8db228919f50e5ad9d92b6263e631e0c8a114"},"metadata_locator":{"path":"materials/tadabbur/fatiha-extended/fa/sources.json","json_pointer":"/sourceDetails/sourceSelections/79"},"arabic_locator":{"path":"materials/tadabbur/ar/extended/001.json","git_blob_sha":"70e5bd721380eaa6cde29397529ed99e04d30577","sha256":"b5e96ac715e85e8ebc2eec31b4441484e9d345758207474d4c6ac5bb45510ce8","json_pointer":"/entries/1:6/blocks/1/text","char_start":435,"char_end":462,"offset_unit":"Unicode code points in decoded JSON string","decoded_utf8_start":787,"decoded_utf8_end":837,"text_sha256":"6441b4ff905ce2d3dd53a82213b427b354c279e561e19e1e29b0151c2183800e"},"source_classification":"hadith_meaning_excerpt","is_excerpt":true,"context_note":"This is an explicitly bounded source excerpt, not the complete Hadith. Separate occurrences are not distinct-Hadith counts.","original_source_metadata":{"id":"H21","unit":"1:6","block":1,"text":"دنیا را بزرگ‌ترین دل‌مشغولی ما قرار مده.","kind":"own_labeled_non_Quran_meaning"},"original_context":"بزرگ‌ترین خواسته‌ای که در هر رکعت تکرار می‌شود، هدایت است. نمازگزار در رکعت‌های نمازهای فرضِ روزانه، هفده بار آن را می‌خواهد. پس از ثنای الله و معرفیِ بندگی و نیازمندیِ خود، به او واگذار نشده است که در این جایگاه، چیزی را که فوری‌ترین نیازش می‌بیند جایگزین کند؛ الله به او آموخته است بگوید: «ما را به راه راست هدایت فرما [و همواره در این راه، ثابت‌قدم بدار]». این انتخاب، بزرگیِ نیازش را به او می‌شناساند، نه کمالِ بی‌نیازی‌اش را. پروردگار، ضعفِ او و انگیزه‌های شهوت و شبهۀ پیرامونش و آنچه می‌تواند از راه بازش دارد می‌داند. مقدم داشتنِ این دغدغه، نیازهای دنیا را نفی نمی‌کند. از دعای پیامبر ﷺ این بود ـ به برگردان معنایی از عربی ـ: «دنیا را بزرگ‌ترین دل‌مشغولی ما قرار مده.» درخواست آن نبود که انسان در دنیا اصلاً هیچ دغدغه‌ای نداشته باشد.","original_arabic_reference":{"source_token":"H21","reference":"tirmidhi:3502","scope":"original_lesson_reference; published parallels may differ","locator":{"path":"materials/tadabbur/fatiha-extended/uz/sources.json","json_pointer":"/quotationRoutes/76"}}}},"translator":{"name":null,"evidence":null},"translation_provenance":{"origin":"unknown","label":"Unknown","ai_translation":"unknown","basis":"Copied Iman/old-bank material: owner confirmation pending. Historical source wording and authorship metadata remain preserved.","human_involvement":"not_established","evidence_ids":[],"scope_note":"Original source metadata is preserved; current translation classification follows the recorded provenance evidence and owner policy.","policy_path":null},"extraction":{"ocr_used":false,"method":"structured_source_quote","classification":"digital_text","evidence_fields":["extraction.ocr_used"],"conflicting_evidence":false},"topic_tags":[],"editorial_tags":[],"source_headings":[],"review":{"status":"source_extracted","independent_pro_qc":"not_asserted","release_status":"source_candidate","release_eligible":false,"certified_release_eligible":false,"issues":[]},"commentary":{"arabic":null,"translation":"This is an explicitly bounded source excerpt, not the complete Hadith. Separate occurrences are not distinct-Hadith counts."},"benefits":null,"footnotes":[],"references":{"items":[{"book_key":"tirmidhi","collection":"Jami al-Tirmidhi","number":"3502","scope":"main_quote","source_citation":"tirmidhi:3502","numbering_scheme":"as_cited_in_source","verification":"explicit_source_citation_not_independent_edition_alignment","locator":{"path":"materials/tadabbur/fatiha-extended/uz/sources.json","git_blob_sha":"6008bcc8c3ff1937a46093b955070892cc27b90e","sha256":"ea10b825576fb78ef5ea7d96aad8c6515360b187d8b5ce8b786be494c10b984f","json_pointer":"/quotationRoutes/76/originalReference","char_start":0,"char_end":13,"offset_unit":"Unicode code points in decoded JSON string","decoded_utf8_sta