      {
        "change": "restore actual attributed interpretation as separate component; correct former lexical-apparatus metadata on unchanged prohibition text",
        "id": "deenhindi-nasai:2492",
        "language": "hi",
        "original_prohibition_component_id_retained": "report-1",
        "original_prohibition_end": 359,
        "original_prohibition_start": 276,
        "refinement": "Final source-based refinement after independent review: the opening is an explicitly transmitted interpretation identifying the verse's referent, not a dictionary synonym. Preserve it under the source-named interpreter's own voice, with the quoted verse/rendering as its stated subject. No recitation event or external biographical identity is inferred. Keep the separately attributed actual Prophetic prohibition in its original report-1 component and original family; its former lexical-apparatus type/description is corrected transparently. Only the Urdu verse locator remains context.",
        "restored_spans": [
          {
            "end": 276,
            "sha256": "83a7929bca8df5dea56158cd1134f19acd62ee2d698db150a6dd47f876219afe",
            "start": 0,
            "text": "इब्न शिहाब ज़ुहरी कहते हैं कि अबू उम्मा बिन सहल बिन हुनैफ़ (रज़ियल्लाहु अन्हु) ने अल्लाह अज़्ज़ा-व-जल के फरमान 'वाला तयम्मामु आल-कहबिथा मिनहु तूंफीकुन' (अल्लाह की राह में बुरा माल ख़र्च करने का क़स्द न करो) के मुताल्लिक़ मुझसे बयां किया के खाबीत से मुराद 'जरूर' और 'लोन-इ-हबीक' हैं. "
          }
        ],
        "source_text_sha256": "a04c60b219bad4ee97348f092cddb56b3fff92c2b731ae2b7b37e504c38428c6"
      },
