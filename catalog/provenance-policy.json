  "human_translation_does_not_imply_independent_qc": true,
  "unknown_does_not_mean_ai": true,
  "owner_instruction_verbatim": "only old bank resources should labelled as translation unkown , all new books are human translated unless the sources said other wise (which i doubt )",
  "new_material_rule": {
