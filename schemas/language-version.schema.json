{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadith-bank/language-version.schema.json",
  "title": "Source-bound language version",
  "type": "object",
  "required": [
    "id",
    "language",
    "text",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$"
    },
    "script": {
      "type": [
        "string",
        "null"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream_sources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "translation_provenance": {
      "type": [
        "object",
        "null"
      ]
    },
    "scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "match_status": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
