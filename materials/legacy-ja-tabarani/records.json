      "historical_metadata": {
        "part": {
          "text": "「アッラーの恵みについて深く考えなさい」",
          "kind": "hadith"
        },
        "source_notes": [
          {
            "id": "H7",
            "text": "タバラーニー『中伝承集』6319の意味訳。完全な文言は「アッラーの恵みについて深く考えなさい。アッラーご自身について深く考えてはならない」です。後半は、かれの本質やあり方を思い描こうとすることを戒めています。個別の経路の弱さと、裏づけとなる伝承を合わせた評価は、出典資料で区別しています。",
            "label": "注 H7"
          }
        ]
      },
      "arabic_quote_locator": null
    },
