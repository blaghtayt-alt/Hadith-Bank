      {
        "role": "translation",
        "source_stream_start": 355600,
        "source_stream_end": 355833,
        "text_verbatim": "Perguntou ao Profeta ﷺ “Se um caçador lançar uma flecha em animal e\ndepois de rastreá-lo por dois ou três dias ele o encontra morto, mas ainda carregando\nsua flecha, se poderia comê-lo”? O Profeta ﷺ respondeu: “Pode comer se quiser”.",
        "source_segments": [
          {
            "pdf_page": 163,
            "printed_page": "159",
            "line_id": "p0163_l003",
            "bbox": [
