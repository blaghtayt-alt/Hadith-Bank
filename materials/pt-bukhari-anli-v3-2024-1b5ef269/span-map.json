        "role": "narrator_attribution",
        "source_stream_start": 352395,
        "source_stream_end": 352431,
        "text_verbatim": "Segundo Ibn Omar رضي الله عنه narra:",
        "source_segments": [
          {
            "pdf_page": 161,
            "printed_page": "157",
            "line_id": "p0161_l018",
            "bbox": [
              90.70619201660156,
              329.3125915527344,
              228.2501678466797,
              344.7205810546875
            ],
            "line_char_start": 0,
            "line_char_end": 36,
            "text": "Segundo Ibn Omar رضي الله عنه narra:"
          }
        ]
      },
      {
        "role": "translation",
        "source_stream_start": 352433,
        "source_stream_end": 352652,
        "text_verbatim": "O Profeta ﷺ disse: “Quem tiver um cão (de estimação) que não seja cão\nde guarda nem cão de caça, terá uma dedução diária de dois Qirat (ou seja, um\nQirat é equivalente ao tamanho de montanha de Uhd) de suas boas ações”.",
        "source_segments": [
          {
            "pdf_page": 161,
            "printed_page": "157",
            "line_id": "p0161_l019",
            "bbox": [
              90.70619201660156,
              351.0445861816406,
              414.0762939453125,
              366.45257568359375
            ],
            "line_char_start": 0,
            "line_char_end": 69,
            "text": "O Profeta ﷺ disse: “Quem tiver um cão (de estimação) que não seja cão"
          },
          {
            "pdf_page": 161,
            "printed_page": "157",
            "line_id": "p0161_l020",
            "bbox": [
              56.68619155883789,
              365.6846008300781,
              414.03179931640625,
              380.7445983886719
            ],
            "line_char_start": 0,
            "line_char_end": 77,
            "text": "de guarda nem cão de caça, terá uma dedução diária de dois Qirat (ou seja, um"
          },
          {
            "pdf_page": 161,
            "printed_page": "157",
            "line_id": "p0161_l021",
            "bbox": [
              56.68619155883789,
              380.1686096191406,
              413.9875183105469,
              395.42059326171875
            ],
            "line_char_start": 0,
            "line_char_end": 71,
            "text": "Qirat é equivalente ao tamanho de montanha de Uhd) de suas boas ações”."
          }
        ],
        "unit_id": "pt_bukhari_v3_0497_unit_01"
      },
      {
        "role": "original_compilation_reference",
        "source_stream_start": 352653,
        "source_stream_end": 352697,
