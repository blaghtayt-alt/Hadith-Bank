    "bodyEqualsSourcePrefix": true,
    "terminalReferenceExcludedFromBody": "Sahih Al-Bukhari, 5480, Livro 72, Hadith 05.",
    "sourceStreamSpan": [
      351735,
      352296
    ],
    "sourceComponentsPreserved": [
      {
        "role": "narrator_attribution",
        "source_stream_start": 351735,
        "source_stream_end": 351785,
        "text_verbatim": "Segundo Abdullah Bin Maghaffal رضي الله عنه narra:",
        "source_segments": [
          {
            "pdf_page": 161,
            "printed_page": "157",
            "line_id": "p0161_l009",
            "bbox": [
              90.7009048461914,
              177.18215942382812,
              292.7917175292969,
              192.5901641845703
            ],
            "line_char_start": 0,
            "line_char_end": 50,
            "text": "Segundo Abdullah Bin Maghaffal رضي الله عنه narra:"
          }
        ]
      },
      {
        "role": "translation",
        "source_stream_start": 351787,
        "source_stream_end": 352296,
        "text_verbatim": "Viu um homem jogando pedras com dois dedos (em alguma coisa) e\ndisse-lhe: “Não jogue pedras, pois o Mensageiro de Allah ﷺ proibiu atirar pedras,\nou ele costumava não gostar disso”. Abdullah رضي الله عنه acrescentou: “Atirar pedras não\nvai caçar a presa, nem matar (ou ferir) um inimigo, mas pode quebrar um dente\nou arrancar um olho! Eu lhes digo que o Mensageiro de Allah ﷺ proibiu ou não\ngostava de jogar pedras (de tal maneira), mas tu estás jogando pedras! Eu não vou\nfalar contigo por tal e tal período”.",
        "source_segments": [
          {
            "pdf_page": 161,
            "printed_page": "157",
            "line_id": "p0161_l010",
            "bbox": [
              90.7009048461914,
              199.07015991210938,
              414.0050048828125,
              214.32215881347656
            ],
            "line_char_start": 0,
            "line_char_end": 62,
            "text": "Viu um homem jogando pedras com dois dedos (em alguma coisa) e"
          },
          {
            "pdf_page": 161,
            "printed_page": "157",
            "line_id": "p0161_l011",
            "bbox": [
              56.692901611328125,
              213.40737915039062,
              413.98370361328125,
              228.8153839111328
            ],
            "line_char_start": 0,
            "line_char_end": 81,
            "text": "disse-lhe: “Não jogue pedras, pois o Mensageiro de Allah ﷺ proibiu atirar pedras,"
          },
          {
            "pdf_page": 161,
            "printed_page": "157",
            "line_id": "p0161_l012",
            "bbox": [
              56.692901611328125,
              227.89547729492188,
              413.97015380859375,
              243.11148071289062
            ],
            "line_char_start": 0,
            "line_char_end": 89,
            "text": "ou ele costumava não gostar disso”. Abdullah رضي الله عنه acrescentou: “Atirar pedras não"
          },
          {
            "pdf_page": 161,
            "printed_page": "157",
            "line_id": "p0161_l013",
            "bbox": [
              56.692901611328125,
              242.53549194335938,
              414.0289001464844,
              257.5954895019531
            ],
            "line_char_start": 0,
            "line_char_end": 77,
            "text": "vai caçar a presa, nem matar (ou ferir) um inimigo, mas pode quebrar um dente"
          },
          {
            "pdf_page": 161,
            "printed_page": "157",
            "line_id": "p0161_l014",
            "bbox": [
              56.692901611328125,
              256.8634948730469,
              414.01580810546875,
              272.0794982910156
            ],
            "line_char_start": 0,
            "line_char_end": 76,
            "text": "ou arrancar um olho! Eu lhes digo que o Mensageiro de Allah ﷺ proibiu ou não"
          },
          {
            "pdf_page": 161,
            "printed_page": "157",
            "line_id": "p0161_l015",
            "bbox": [
              56.692901611328125,
              271.5035095214844,
              414.02288818359375,
              286.5635070800781
            ],
            "line_char_start": 0,
            "line_char_end": 81,
            "text": "gostava de jogar pedras (de tal maneira), mas tu estás jogando pedras! Eu não vou"
          },
          {
            "pdf_page": 161,
            "printed_page": "157",
            "line_id": "p0161_l016",
            "bbox": [
              56.692901611328125,
              286.0043029785156,
              411.1580505371094,
              301.25628662109375
            ],
            "line_char_start": 0,
            "line_char_end": 37,
            "text": "falar contigo por tal e tal período”."
          }
        ],
        "unit_id": "pt_bukhari_v3_0496_unit_01"
      },
      {
        "role": "original_compilation_reference",
        "source_stream_start": 352297,
        "source_stream_end": 352341,
        "text_verbatim": "Sahih Al-Bukhari, 5480, Livro 72, Hadith 05.",
        "source_segments": [
          {
            "pdf_page": 161,
