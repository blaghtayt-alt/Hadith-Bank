        "role": "narrator_attribution",
        "source_stream_start": 326839,
        "source_stream_end": 326874,
        "text_verbatim": "Segundo Abu Othman رحمه الله narra:",
        "source_segments": [
          {
            "pdf_page": 148,
            "printed_page": "144",
            "line_id": "p0148_l020",
            "bbox": [
              76.5396957397461,
              380.0209655761719,
              231.77052307128906,
              395.428955078125
            ],
            "line_char_start": 0,
            "line_char_end": 35,
            "text": "Segundo Abu Othman رحمه الله narra:"
          }
        ]
      },
      {
        "role": "translation",
        "source_stream_start": 326876,
        "source_stream_end": 327357,
        "text_verbatim": "Fui hóspede de Abu Hurairah رضي الله عنه por sete dias. Abu Hurairah رضي الله عنه, sua\nesposa e seu escravo costumavam se levantar e ficar acordados um terço da noite por\nturnos. Cada um fazia a oração noturna e depois despertava o outro. Ouvi Abu\nHurairah رضي الله عنه dizendo: “O Mensageiro de Allah ﷺ distribuiu tâmaras entre seus\ncompanheiros e minha parte foi de sete tâmaras, uma das quais era uma Hasha-\nfah (uma tâmara que secou na árvore antes de estar totalmente madura).",
        "source_segments": [
          {
            "pdf_page": 148,
            "printed_page": "144",
            "line_id": "p0148_l021",
            "bbox": [
              76.5354995727539,
              401.7537841796875,
              399.86199951171875,
              416.96978759765625
            ],
            "line_char_start": 0,
            "line_char_end": 86,
            "text": "Fui hóspede de Abu Hurairah رضي الله عنه por sete dias. Abu Hurairah رضي الله عنه, sua"
          },
          {
            "pdf_page": 148,
            "printed_page": "144",
            "line_id": "p0148_l022",
            "bbox": [
              42.51969909667969,
              416.3979797363281,
              399.76824951171875,
              431.4579772949219
            ],
            "line_char_start": 0,
            "line_char_end": 83,
            "text": "esposa e seu escravo costumavam se levantar e ficar acordados um terço da noite por"
          },
          {
            "pdf_page": 148,
            "printed_page": "144",
            "line_id": "p0148_l023",
            "bbox": [
              42.51969909667969,
              430.8861999511719,
              399.8558349609375,
              445.9461975097656
            ],
            "line_char_start": 0,
            "line_char_end": 76,
            "text": "turnos. Cada um fazia a oração noturna e depois despertava o outro. Ouvi Abu"
          },
          {
            "pdf_page": 148,
            "printed_page": "144",
            "line_id": "p0148_l024",
            "bbox": [
              42.51969909667969,
              445.2183837890625,
              399.84136962890625,
              460.43438720703125
            ],
            "line_char_start": 0,
            "line_char_end": 85,
            "text": "Hurairah رضي الله عنه dizendo: “O Mensageiro de Allah ﷺ distribuiu tâmaras entre seus"
          },
          {
            "pdf_page": 148,
            "printed_page": "144",
            "line_id": "p0148_l025",
            "bbox": [
              42.51969909667969,
              459.8583679199219,
              396.82928466796875,
              474.9183654785156
            ],
            "line_char_start": 0,
            "line_char_end": 76,
            "text": "companheiros e minha parte foi de sete tâmaras, uma das quais era uma Hasha-"
          },
          {
            "pdf_page": 148,
            "printed_page": "144",
            "line_id": "p0148_l026",
            "bbox": [
              42.51969909667969,
              474.3507995605469,
              399.8515930175781,
              489.602783203125
            ],
            "line_char_start": 0,
            "line_char_end": 70,
            "text": "fah (uma tâmara que secou na árvore antes de estar totalmente madura)."
          }
        ],
        "unit_id": "pt_bukhari_v3_0456_unit_01"
      },
      {
