        "source_stream_start": 327405,
        "source_stream_end": 327445,
        "text_verbatim": "Segundo Abu Hurairah رضي الله عنه narra:",
        "source_segments": [
          {
            "pdf_page": 148,
            "printed_page": "144",
            "line_id": "p0148_l028",
            "bbox": [
              76.53970336914062,
              510.4149475097656,
              231.9145050048828,
              525.8229370117188
            ],
            "line_char_start": 0,
            "line_char_end": 40,
            "text": "Segundo Abu Hurairah رضي الله عنه narra:"
          }
        ]
      },
      {
        "role": "translation",
        "source_stream_start": 327447,
        "source_stream_end": 327623,
        "text_verbatim": "O Profeta ﷺ distribuiu tâmaras entre nós, e minha parte foi de cinco\ntâmaras, quatro das quais eram boas, e uma era Hashafah, e achei a Hashafa a\nmais difícil para meus dentes.",
        "source_segments": [
          {
            "pdf_page": 148,
            "printed_page": "144",
            "line_id": "p0148_l029",
            "bbox": [
              76.5354995727539,
              532.1475219726562,
              399.9070129394531,
              547.363525390625
            ],
            "line_char_start": 0,
            "line_char_end": 68,
            "text": "O Profeta ﷺ distribuiu tâmaras entre nós, e minha parte foi de cinco"
          },
          {
            "pdf_page": 148,
            "printed_page": "144",
            "line_id": "p0148_l030",
            "bbox": [
              42.51969909667969,
              546.7916870117188,
              399.8076171875,
              561.8516845703125
            ],
            "line_char_start": 0,
            "line_char_end": 76,
            "text": "tâmaras, quatro das quais eram boas, e uma era Hashafah, e achei a Hashafa a"
          },
          {
            "pdf_page": 148,
            "printed_page": "144",
            "line_id": "p0148_l031",
            "bbox": [
              42.51969909667969,
              561.2798461914062,
              393.66131591796875,
              576.5318603515625
            ],
            "line_char_start": 0,
            "line_char_end": 30,
            "text": "mais difícil para meus dentes."
          }
        ],
        "unit_id": "pt_bukhari_v3_0457_unit_01"
      },
