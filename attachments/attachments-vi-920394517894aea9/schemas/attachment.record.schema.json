{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hadith-bank:attachment-candidate:v1",
  "title": "Hadith Bank private attachment narration occurrence",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "language",
    "record_type",
    "narration_unit",
    "text",
    "book",
    "number",
    "narrator",
    "source",
    "translator",
    "page",
    "references",
    "commentary",
    "footnotes",
    "grading",
    "ai_translation",
    "provenance",
    "review",
    "record_id",
    "occurrence_id",
    "extraction_schema_version",
    "source_language_code",
    "content_kind",
    "topic_tags",
    "source_structure_tags",
    "editorial_tags",
    "rights",
    "metadata_gaps",
    "source_occurrence_group",
    "related_source_entries"
  ],
  "properties": {
    "schema_version": {
      "const": "hadith-bank-attachment-candidate-v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "ja",
        "vi",
        "zh-CN",
        "uz",
        "hi",
        "ur",
        "bn",
        "pt"
      ]
    },
    "record_type": {
      "type": "string",
      "minLength": 1
    },
    "narration_unit": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "object",
      "required": [
        "arabic",
        "translation"
      ],
      "properties": {
        "arabic": {
          "type": [
            "string",
            "null"
          ]
        },
        "translation": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "arabic": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "translation": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "book": {
      "type": "object",
      "required": [
        "title",
        "chapter",
        "section",
        "edition",
        "compiler"
      ],
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "chapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "edition": {
          "type": [
            "object",
            "string",
            "null"
          ]
        },
        "compiler": {
          "type": [
            "object",
            "string",
            "null"
          ]
        }
      }
    },
    "number": {
      "type": "object",
      "required": [
        "in_book",
        "canonical"
      ],
      "properties": {
        "in_book": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_entry_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "narrator": {
      "type": "object",
      "required": [
        "name",
        "verbatim",
        "language"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "verbatim": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "file",
        "sha256",
        "title",
        "format",
        "package_file"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "enum": [
            "pdf",
            "xlsx"
          ]
        },
        "package_file": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "translator": {
      "type": "object",
      "required": [
        "name",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "pdf",
        "printed",
        "sheet",
        "row"
      ],
      "properties": {
        "pdf": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "printed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sheet": {
          "type": [
            "string",
            "null"
          ]
        },
        "row": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "references": {
      "type": "object",
      "required": [
        "arabic",
        "translation",
        "items"
      ],
      "properties": {
        "arabic": {
          "type": [
            "string",
            "null"
          ]
        },
        "translation": {
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "type": "array"
        }
      }
    },
    "commentary": {
      "type": "object",
      "required": [
        "arabic",
        "translation",
        "items"
      ],
      "properties": {
        "arabic": {
          "type": [
            "string",
            "null"
          ]
        },
        "translation": {
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "type": "array"
        }
      }
    },
    "footnotes": {
      "type": "array"
    },
    "grading": {
      "type": "object"
    },
    "ai_translation": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "extraction_method"
      ]
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "issues",
        "release_status",
        "independent_pro_qc",
        "release_eligible",
        "mechanical_validation_report"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "issues": {
          "type": "array"
        },
        "release_status": {
          "const": "private_candidate"
        },
        "independent_pro_qc": {
          "const": "pending"
        },
        "release_eligible": {
          "const": false
        },
        "mechanical_validation_report": {
          "const": "reports/validation.json"
        }
      }
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1
    },
    "extraction_schema_version": {
      "const": "1.0.0"
    },
    "source_language_code": {
      "enum": [
        "ja",
        "vi",
        "zh",
        "uz",
        "hi",
        "ur",
        "bn",
        "pt"
      ]
    },
    "content_kind": {
      "const": "source_narration_occurrence_not_independently_classified"
    },
    "topic_tags": {
      "type": "array",
      "maxItems": 0,
      "description": "No publisher category tables supplied in this intake. Do not fabricate category assignments."
    },
    "source_structure_tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tag_id",
          "origin",
          "language",
          "field",
          "value_verbatim",
          "source_id",
          "evidence"
        ],
        "properties": {
          "tag_id": {
            "type": "string",
            "pattern": "^structure:"
          },
          "origin": {
            "const": "source_book_structure"
          },
          "field": {
            "enum": [
              "division",
              "part",
              "volume",
              "chapter",
              "section",
              "subsection"
            ]
          },
          "value_verbatim": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "required": [
              "source_field",
              "extraction_record_id",
              "record_location",
              "location_scope"
            ]
          }
        }
      }
    },
    "editorial_tags": {
      "type": "object",
      "required": [
        "origin",
        "values"
      ],
      "properties": {
        "origin": {
          "const": "import_pipeline_not_publisher"
        },
        "values": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "required": [
        "status",
        "reuse_basis",
        "publication_authorized_by_this_import",
        "source_conditions_path"
      ],
      "properties": {
        "status": {
          "const": "not_assessed_for_publication"
        },
        "reuse_basis": {
          "type": "null"
        },
        "publication_authorized_by_this_import": {
          "const": false
        },
        "source_conditions_path": {
          "type": "string"
        }
      }
    },
    "metadata_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_occurrence_group": {
      "type": "object",
      "required": [
        "id",
        "basis"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "related_source_entries": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
