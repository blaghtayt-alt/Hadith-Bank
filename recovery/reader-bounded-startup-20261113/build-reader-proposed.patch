+def _reader_manifest_parts(manifest):
+    if manifest.get('schema') == 'hadith-bank-reader-shards-v1':
+        return manifest.get('shards', [])
+    if manifest.get('schema') == 'hadith-bank-reader-lazy-v2':
+        return [part for name in ('directory', 'search', 'annotations', 'details')
+                for part in manifest.get(name, {}).get('shards', [])]
+    return []
+
